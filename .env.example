# PowerShell 中应使用 `$env:变量名 = "值"` 注入；本文件不会被应用自动加载。
# 普通用户直接在软件中选择服务商和模型即可；以下公开值只用于高级部署覆盖。
# 请勿把真实 API Key 写入此文件、提交记录或日志。
MEETING_DESK_ASR_PRESET_ID=dashscope_funasr_cn
MEETING_DESK_ASR_PROVIDER_KIND=dashscope_funasr
MEETING_DESK_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
MEETING_DESK_ASR_MODEL=fun-asr
# 可选托管 ASR 预设：
# Xiaomi MiMo: xiaomi_mimo_asr / xiaomi_mimo / https://api.xiaomimimo.com/v1/chat/completions / mimo-v2.5-asr
# 火山引擎极速版: volcengine_asr_flash / volcengine_asr / https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash / bigmodel
MEETING_DESK_LLM_PRESET_ID=deepseek
MEETING_DESK_LLM_PROVIDER_KIND=openai_compatible
MEETING_DESK_LLM_BASE_URL=https://api.deepseek.com/chat/completions
MEETING_DESK_LLM_MODEL=deepseek-v4-flash
MEETING_DESK_CONNECT_TIMEOUT_MS=10000
MEETING_DESK_REQUEST_TIMEOUT_MS=60000
MEETING_DESK_MAX_RETRIES=2
MEETING_DESK_ASR_API_KEY=
MEETING_DESK_LLM_API_KEY=
