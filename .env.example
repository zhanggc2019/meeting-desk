# PowerShell 中应使用 `$env:变量名 = "值"` 注入；本文件不会被应用自动加载。
# 本地 ASR 默认自动读取仓库根目录 model/SenseVoiceSmall 与 .venv；以下值只用于高级部署覆盖。
# 请勿把真实 API Key 写入此文件、提交记录或日志。
MEETING_DESK_ASR_PRESET_ID=local_funasr
MEETING_DESK_ASR_PROVIDER_KIND=local_funasr
MEETING_DESK_ASR_BASE_URL=local://model/SenseVoiceSmall
MEETING_DESK_ASR_MODEL=SenseVoiceSmall
# MEETING_DESK_ASR_MODEL_DIR=D:\models\SenseVoiceSmall
# MEETING_DESK_FUNASR_PYTHON=D:\Projects\funasr-demo\.venv\Scripts\python.exe
MEETING_DESK_LLM_PRESET_ID=deepseek
MEETING_DESK_LLM_PROVIDER_KIND=openai_compatible
MEETING_DESK_LLM_BASE_URL=https://api.deepseek.com/chat/completions
MEETING_DESK_LLM_MODEL=deepseek-v4-flash
MEETING_DESK_CONNECT_TIMEOUT_MS=10000
MEETING_DESK_REQUEST_TIMEOUT_MS=60000
MEETING_DESK_MAX_RETRIES=2
MEETING_DESK_LLM_API_KEY=
