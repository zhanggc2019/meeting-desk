{
  "name": "meeting-desk",
  "private": true,
  "version": "0.3.12",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "pnpm typecheck && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "cargo test --manifest-path src-tauri/Cargo.toml commands::tasks::tests::mock_pipeline_persists_transcript_and_minutes",
    "test:python": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& '.\\src-tauri\\runtime\\python\\python.exe' '.\\src-tauri\\python\\test_local_funasr.py'\"",
    "test:watch": "vitest",
    "runtime:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\prepare-python-runtime.ps1",
    "runtime:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\prepare-python-runtime.ps1 -CheckOnly",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.ci.conf.json",
    "tauri:build:ci": "tauri build --config src-tauri/tauri.ci.conf.json",
    "tauri:build:release": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^26.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.0"
  }
}
